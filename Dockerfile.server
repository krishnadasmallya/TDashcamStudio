# Multi-stage build for TDashcam Studio Server Edition
FROM node:18-alpine AS server-builder

WORKDIR /app/server
COPY server/package.json ./
RUN npm install --omit=dev

FROM nginx:alpine

# Install Node.js for the API server
RUN apk add --no-cache nodejs npm

# Copy server files
COPY --from=server-builder /app/server/node_modules /app/server/node_modules
COPY server /app/server

# Copy frontend files
COPY src /usr/share/nginx/html

# Create nginx config that proxies API requests to Node.js
RUN echo 'server { \
    listen 80; \
    root /usr/share/nginx/html; \
    index index.html; \
    \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    \
    location /api/ { \
        proxy_pass http://127.0.0.1:3000; \
        proxy_http_version 1.1; \
        proxy_set_header Upgrade $http_upgrade; \
        proxy_set_header Connection "upgrade"; \
        proxy_set_header Host $host; \
        proxy_cache_bypass $http_upgrade; \
    } \
}' > /etc/nginx/conf.d/default.conf

# Create startup script
COPY <<EOF /start.sh
#!/bin/sh
set -e
echo "Starting Node.js server..."
cd /app/server
node server.js &
SERVER_PID=\$!
echo "Node.js server started with PID \$SERVER_PID"
echo "Starting Nginx..."
nginx -g "daemon off;"
EOF

RUN chmod +x /start.sh

EXPOSE 80

CMD ["/start.sh"]
